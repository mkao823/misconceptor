# Copy to .env (gitignored) and fill in. Names must match api_key_env in configs/models.yaml.
#
# The default model (gpt-oss:20b through local Ollama) needs no key and no .env file:
# Ollama ignores the key, and src/config.py supplies a placeholder when the variable is unset.
# OLLAMA_API_KEY=
#
# Only needed if you uncomment a hosted provider in configs/models.yaml:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
